# P.A.T.H.F.I.N.D.E.R. Global Navigation & Next-Gen Maps Backend Configuration
# Copy this file to .env and configure appropriate keys/endpoints where applicable.

# Application Environment Mode: LIVE_ROUTING, STANDARD_ROUTING, or DEMO_MODE
CAMPUSAEGIS_MODE=LIVE_ROUTING
ENVIRONMENT=development
DEBUG=false

# =========================================================================
# Database Configuration (SQLite default; PostgreSQL with PostGIS in production)
# =========================================================================
DATABASE_URL=sqlite:///./data/pathfinder_maps.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pathfinder_gis

# =========================================================================
# Security & JWT Authentication
# =========================================================================
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================================================================
# Google Maps Platform Configuration (Official JavaScript SDK, Places & Geocoding)
# =========================================================================
# Obtain an API key from Google Cloud Console: https://console.cloud.google.com/
# Required APIs to enable:
# 1. Maps JavaScript API (Interactive web map, controls, polylines, InfoWindows)
# 2. Places API (New) / Places API (Autocomplete place & address search)
# 3. Geocoding API (Address to GPS coordinates conversion)
GOOGLE_MAPS_API_KEY=

# Global Geocoding Provider Settings (OpenStreetMap Nominatim / Photon / Self-Hosted)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_PROVIDER=nominatim
GEOCODING_TIMEOUT_SEC=4.0

# Global Routing Provider Settings (OSRM / OpenStreetMap / GraphHopper)
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SEC=4.0

# Weather Provider Configuration (Open-Meteo Free API / NOAA)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Offline Packages Storage Directory
OFFLINE_PACKAGES_DIR=./data/offline_packages

# Optional Real-Time Traffic & Road Condition Feeds (Leave empty for standard routing)
TRAFFIC_API_KEY=
TRAFFIC_FEED_URL=
HAZARD_FEED_URL=
TRAFFIC_FUSION_K_ANONYMITY_THRESHOLD=3
TRAFFIC_DECAY_HALF_LIFE_SEC=180
TRAFFIC_UNCERTAINTY_PENALTY_WEIGHT=0.25

# Journey & Location Settings (Vignan University Regional Hub Center)
DEFAULT_LATITUDE=16.2335
DEFAULT_LONGITUDE=80.5505
LOCATION_STALENESS_THRESHOLD_SEC=120.0
LOCATION_ACCURACY_THRESHOLD_M=50.0

# Server Settings
PORT=8501
HOST=0.0.0.0
API_SERVER_PORT=8000
