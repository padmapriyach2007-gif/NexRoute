# NexRoute Mobile Environment Configuration Example
# Development: Use your local computer's LAN IP (not localhost, because physical phones use localhost for themselves)
# e.g., http://192.168.1.100:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org
EXPO_PUBLIC_OLLAMA_BASE_URL=http://10.0.2.2:11434
EXPO_PUBLIC_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_ENABLE_OFFLINE_FALLBACK=true
