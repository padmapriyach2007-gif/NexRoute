{
  "expo": {
    "name": "NexRoute Mobile",
    "slug": "nexroute-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "nexroute",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexroute.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NexRoute uses your location to provide real-time turn-by-turn navigation, rerouting, and proximity search for destinations and emergency facilities.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NexRoute uses background location when you are actively navigating a route to provide voice turn-by-turn guidance even when your screen is locked.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "com.nexroute.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NexRoute needs access to your device location to provide real-time GPS navigation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
